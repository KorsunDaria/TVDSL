// gcd: precondition, return value, locals, loop with invariant
gcd(x: int, y: int)
  requires x >= 0 and y >= 0
  returns r: int
  ensures r >= 0
  uses a: int, b: int
{
  a = x;
  b = y;
  while (b != 0)
    invariant a >= 0 and b >= 0
  {
    r = a;
    a = b;
    b = r - (r / b) * b;
  }
  r = a;
}

// formula with a quantifier and implication
sorted(a: int[]) =>
  forall (i: int | i >= 0 and i + 1 < length(a) -> a[i] <= a[i + 1])

// arrays: a[i] = e is sugar for a = update(a, i, e)
fill(a: int[], v: int)
  returns b: int[]
  ensures sorted(b)
  uses i: int
{
  b = a;
  i = 0;
  while (i < length(a))
    invariant 0 <= i
    b[i] = v;
}

// tuple assignment, dangling else, not/and/or
divide(a: int, b: int)
  requires b != 0
  returns q: int, r: int
{
  q = a / b;
  r = a - q * b;
}

caller(a: int, b: int)
  returns q: int, r: int
{
  q, r = divide(a, b);
  assert a == q * b + r;
  if (not (q > 0) or r == 0)
    q = -q;
  else
    r = 0;
}
